# AI-module debug view for the CMU VLN Challenge 2026 sim (Unity + ROS-TCP bridge).
#
# This is OUR additive debug layout — the base autonomy stack already opens its own
# system RVIZ (visualization_tools, vehicle_simulator.rviz) when system_simulation.sh runs.
# This config exists to watch what OUR ai_module (src/ros_adapter/adapter_node.py) believes
# and publishes during a sim run. Load it via ai_module_debug.launch.py (debug_viz:=true).
#
# Conventions follow data/sample_real_robot/data_view.rviz2 (the organizers' own layout):
# rviz2 config schema, Fixed Frame = map, PointCloud2 defaults, Image panel.
# Displays are grouped into three logical folders: Sensors / Autonomy / AI Module.
Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 633
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: RegScan
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    # ------------------------------------------------------------------ Sensors
    - Class: rviz_common/Group
      Name: Sensors
      Enabled: true
      Displays:
        - Alpha: 1
          Class: rviz_default_plugins/Axes
          Enabled: true
          Length: 1
          Name: Vehicle
          Radius: 0.15000000596046448
          Reference Frame: vehicle
          Show Trail: false
          Value: true
        # /registered_scan — lidar in map frame. Subdued: flat grey, low alpha, small points.
        - Alpha: 0.20000000298023224
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 160; 160; 160
          Color Transformer: FlatColor
          Decay Time: 10
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: RegScan
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 1
          Size (m): 0.05000000074505806
          Style: Points
          Topic: /registered_scan
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        # /terrain_map (5 m) — colored by intensity = obstacle height above ground (the
        # traversability signal). Intensity band 0..0.3 m so floor(~0)=blue, obstacle=red.
        - Alpha: 1
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: true
          Max Color: 255; 255; 255
          Max Intensity: 0.30000001192092896
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: TerrainMap
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.03999999910593033
          Style: Points
          Topic: /terrain_map
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        # /terrain_map_ext (20 m) — same intensity coloring, off by default (clutter).
        - Alpha: 1
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: false
          Invert Rainbow: true
          Max Color: 255; 255; 255
          Max Intensity: 0.30000001192092896
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: TerrainMapExt
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.03999999910593033
          Style: Points
          Topic: /terrain_map_ext
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: false
        # /camera/image — the 1920x640 360-degree panorama fed to our VLM/detector.
        - Class: rviz_default_plugins/Image
          Enabled: true
          Image Topic: /camera/image
          Max Value: 1
          Median window: 5
          Min Value: 0
          Name: Panorama
          Normalize Range: true
          Queue Size: 2
          Transport Hint: raw
          Unreliable: false
          Value: true
    # ------------------------------------------------------------------ Autonomy
    - Class: rviz_common/Group
      Name: Autonomy
      Enabled: true
      Displays:
        # /state_estimation — vehicle pose. Keep-last arrow + short trail.
        - Angle Tolerance: 0.10000000149011612
          Class: rviz_default_plugins/Odometry
          Covariance:
            Orientation:
              Alpha: 0.5
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.30000001192092896
              Color: 204; 51; 204
              Scale: 1
              Value: true
            Value: false
          Enabled: true
          Keep: 100
          Name: StateEstimation
          Position Tolerance: 0.10000000149011612
          Shape:
            Alpha: 1
            Axes Length: 1
            Axes Radius: 0.10000000149011612
            Color: 255; 25; 0
            Head Length: 0.30000001192092896
            Head Radius: 0.10000000149011612
            Shaft Length: 1
            Shaft Radius: 0.05000000074505806
            Value: Arrow
          Topic: /state_estimation
          Value: true
        # /path — nav_msgs/Path from the local planner: the actual driven intent.
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 255
          Enabled: true
          Head Diameter: 0.30000001192092896
          Head Length: 0.20000000298023224
          Length: 0.30000001192092896
          Line Style: Lines
          Line Width: 0.029999999329447746
          Name: LocalPlannerPath
          Offset:
            X: 0
            Y: 0
            Z: 0
          Pose Color: 255; 85; 255
          Pose Style: None
          Radius: 0.029999999329447746
          Shaft Diameter: 0.10000000149011612
          Shaft Length: 0.10000000149011612
          Topic: /path
          Value: true
    # ------------------------------------------------------------------ AI Module
    - Class: rviz_common/Group
      Name: AI Module
      Enabled: true
      Displays:
        # /selected_object_marker — OUR object-reference answer box. Bright green, prominent.
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: AnswerMarker
          Namespaces: {}
          Topic: /selected_object_marker
          Value: true
        # Executed commanded goal. NOTE: our node publishes /way_point_with_heading as
        # geometry_msgs/Pose2D, which RVIZ CANNOT visualize (Pose2D is not a displayable
        # message type). The base stack's waypointConverter republishes our Pose2D as
        # /way_point (geometry_msgs/PointStamped, map frame) into the local planner
        # (upstream_notes.md 5b). We visualize THAT PointStamped as the executed goal.
        - Alpha: 1
          Class: rviz_default_plugins/PointStamped
          Color: 255; 170; 0
          Enabled: true
          History Length: 1
          Name: ExecutedWaypoint
          Radius: 0.20000000298023224
          Topic: /way_point
          Value: true
        # /ai_module/instance_map — OUR tracked InstanceRecords (debug publisher, 1 Hz).
        # One semi-transparent box + text label per instance. Only present when the node
        # is launched with debug_viz:=true (default OFF for eval).
        - Class: rviz_default_plugins/MarkerArray
          Enabled: true
          Name: InstanceMap
          Namespaces: {}
          Topic: /ai_module/instance_map
          Value: true
        # /ai_module/planned_path — OUR breadcrumb of published waypoints (debug publisher).
        # Marker LINE_STRIP. Also only present under debug_viz:=true.
        - Class: rviz_default_plugins/Marker
          Enabled: true
          Name: PlannedPath
          Namespaces: {}
          Topic: /ai_module/planned_path
          Value: true
        # /debug/colored_cloud — OUR live colored voxel map (T6, throttled full republish,
        # default every ~2 s). RGB rides in a packed float32 'rgb' field (Color Transformer:
        # RGB8). Reliable/volatile publisher (ros_adapter.adapter_node._reliable_qos),
        # matches Unreliable: false below. Only present under debug_viz:=true.
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: ColoredMap
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.03999999910593033
          Style: Points
          Topic: /debug/colored_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Default Light: true
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 11.038719177246094
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1.0
      Target Frame: vehicle
      Yaw: 3.1415927410125732
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 784
  Hide Left Dock: false
  Hide Right Dock: false
  Panorama:
    collapsed: false
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1723
  X: 56
  Y: 27
